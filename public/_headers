# Cloudflare Pages. Hashed Vite files are safe to keep for a year.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# The document and the worker must revalidate so a deploy replaces the last build.
/
  Cache-Control: no-cache

/index.html
  Cache-Control: no-cache

/sw.js
  Cache-Control: no-cache
