# Hashed Vite files, including the slim catalog JSON, can stay for a year.
# Do not set no-transform here. Pages compresses these with gzip and brotli.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

/assets/*.json
  Cache-Control: public, max-age=31536000, immutable

# Catalog photos keep their filenames. A year is safe because a new crop is a new file.
/photos/*
  Cache-Control: public, max-age=31536000

/og/*
  Cache-Control: public, max-age=604800

/*.png
  Cache-Control: public, max-age=604800

/*.svg
  Cache-Control: public, max-age=604800

/*.webp
  Cache-Control: public, max-age=31536000

# The document and the worker must revalidate so a deploy replaces the last build.
/
  Cache-Control: no-cache

/index.html
  Cache-Control: no-cache

/sw.js
  Cache-Control: no-cache, no-store, must-revalidate

/hop.htm
  Cache-Control: no-cache

/hop.js
  Cache-Control: no-cache

/status.js
  Cache-Control: no-cache

/cfa.js
  Cache-Control: no-cache

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self' https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline'; font-src 'self'; worker-src 'self' blob:; child-src 'self' blob:; img-src 'self' data: blob: https://upload.wikimedia.org https://commons.wikimedia.org https://live.staticflickr.com https://*.staticflickr.com https://*.supabase.co https://pbs.twimg.com https://*.twimg.com; connect-src 'self' https://*.supabase.co wss://*.supabase.co https://tiles.openfreemap.org https://cloudflareinsights.com; upgrade-insecure-requests

