{
  "name": "gustos-guide",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/lint-copy.mjs && node scripts/check-prerender.mjs && node --experimental-strip-types scripts/write-legal.mjs && node scripts/write-sitemap.mjs && node scripts/write-og-png.mjs && node scripts/write-share-pages.mjs && node scripts/write-slim-catalog.mjs && tsc -b && vite build && node scripts/stamp-cfa.mjs && node scripts/stamp-sw.mjs",
    "deploy:cf": "wrangler pages deploy dist --project-name gustos-guide",
    "lint": "oxlint && node scripts/lint-copy.mjs",
    "test:e2e": "playwright test",
    "test:stamp": "node scripts/stamp-sw.test.mjs",
    "content": "node scripts/build-content.mjs",
    "photos": "node scripts/fetch-photos.mjs",
    "wikimedia": "node scripts/fetch-wikimedia.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "@fontsource/instrument-sans": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@maplibre/maplibre-gl-leaflet": "^0.1.4",
    "@supabase/supabase-js": "^2.118.0",
    "framer-motion": "^14.3.0",
    "leaflet": "^1.9.4",
    "leaflet.markercluster": "^1.5.3",
    "maplibre-gl": "^6.15.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-leaflet": "^5.0.0",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/leaflet": "^1.9.22",
    "@types/leaflet.markercluster": "^1.5.6",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
